{
  "uid": "loadharbor",
  "title": "LoadHarbor | Gatling Performance",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "gatling",
    "loadharbor"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Total requests",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "loadharbor-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(loadharbor_requests_total)",
          "legendFormat": "{{request}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      }
    },
    {
      "id": 2,
      "title": "Error rate (%)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "loadharbor-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(loadharbor_requests_total{status=\"KO\"}) / clamp_min(sum(loadharbor_requests_total), 1)",
          "legendFormat": "{{request}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      }
    },
    {
      "id": 3,
      "title": "P95 response time",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "loadharbor-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (loadharbor_response_seconds_bucket))",
          "legendFormat": "{{request}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      }
    },
    {
      "id": 4,
      "title": "Run active",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "loadharbor-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "loadharbor_run_active",
          "legendFormat": "{{request}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      }
    },
    {
      "id": 5,
      "title": "Throughput by request",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "loadharbor-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (request) (rate(loadharbor_requests_total[20s]))",
          "legendFormat": "{{request}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      }
    },
    {
      "id": 6,
      "title": "P50 / P90 / P95 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "loadharbor-prometheus"
      },
      "targets": [
        {
          "refId": "0",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(loadharbor_response_seconds_bucket[20s])))",
          "legendFormat": "P50"
        },
        {
          "refId": "1",
          "expr": "histogram_quantile(0.9, sum by (le) (rate(loadharbor_response_seconds_bucket[20s])))",
          "legendFormat": "P90"
        },
        {
          "refId": "2",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(loadharbor_response_seconds_bucket[20s])))",
          "legendFormat": "P95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 9
      }
    },
    {
      "id": 7,
      "title": "Requests by outcome",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "loadharbor-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (loadharbor_requests_total)",
          "legendFormat": "{{request}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 9
      }
    },
    {
      "id": 8,
      "title": "Exporter health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "loadharbor-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"loadharbor\"}",
          "legendFormat": "{{request}} {{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 9
      }
    }
  ]
}